{% if photos is not empty %}
<section class="galerie-section">
    <h2>{{ libelle }}</h2>
    <div class="galerie-section-grid">
        {% for photo in photos %}
            {% set img = gite.media[photo.fichier].resize(1200).quality(80) %}
            {% do img.derivatives(320, 1200, 320) %}
            <figure class="galerie-section-item">
                <img src="{{ img.url(false) }}" srcset="{{ img.srcset }}" sizes="(max-width: 720px) 100vw, 480px" alt="{{ photo.alt|default('Photographie du gîte') }}" loading="lazy">
            </figure>
        {% endfor %}
    </div>
</section>
{% endif %}
