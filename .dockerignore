.git/
Ressources/

# Secrets et comptes — ne doivent jamais entrer dans le contexte de build
*-private.php
grav/user/accounts/
.env
.env.*

# Fixtures de test contenant des valeurs qui ressemblent à des secrets
# (jamais réelles, mais sans intérêt à envoyer au démon de build — voir
# l'incident documenté dans docs/testing.md sur test-secrets.sh)
tests/fixtures/

# Données d'exécution locales, jamais destinées à l'image
grav/user/cache/
grav/user/logs/
grav/user/backup/
grav/user/data/
grav/user/images/
grav/user/.initialized

# Artefacts temporaires, archives, IDE
*.log
*.tmp
*.zip
*.tar
*.tar.gz
.vscode/
.idea/
.DS_Store

# Sorties générées par les tests locaux (pas les scripts eux-mêmes)
tests/output/
tests/**/*.actual
